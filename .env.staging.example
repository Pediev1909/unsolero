# Copy to .env.staging and replace every blank/placeholder with staging-only
# values. This file intentionally cannot start the topology as-is.
POSTGRES_DB=unsolero_staging
POSTGRES_USER=unsolero_staging
POSTGRES_PASSWORD=
APP_VERSION=
# This file targets the isolated localhost Compose overlay. Hosted staging must
# omit this override and use TLS for every managed dependency.
ALLOW_INSECURE_LOCAL_STAGING=true
STAGING_TLS_PORT=8443
STAGING_REDIS_PASSWORD=
STAGING_REDIS_PORT=6380
STAGING_MINIO_ROOT_USER=unsolero-staging
STAGING_MINIO_ROOT_PASSWORD=
STAGING_MINIO_PORT=9000
STAGING_MINIO_CONSOLE_PORT=9001
# Raw-standard base64 for exactly 32 staging-only random bytes.
MFA_ENCRYPTION_KEY=
RATE_LIMIT_KEY_SECRET=
# At least 32 characters, staging-only.
METRICS_TOKEN=
ALERT_PROVIDER=disabled
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
RECORD_OPERATIONAL_CHECKPOINTS=true
BACKUP_NAME=unsolero-phase11-staging
BACKUP_UID=1000
BACKUP_GID=1000
RESTORE_POSTGRES_DB=unsolero_phase11_restore
