# Single-box production environment.
#
# Copy to .env on the server and replace every value. Nothing here is a usable
# default; the placeholders are deliberately invalid so a half-configured host
# fails at startup instead of running with a guessable secret.
#
#   cp .env.production.example .env
#
# Generate the three 32-byte secrets with:
#   openssl rand -base64 32 | tr -d '='
#
# The trailing padding must be stripped. Configuration decodes these as raw
# base64, so a value straight out of `openssl rand -base64 32` is rejected at
# startup even though it looks correct.
#
# Never commit the filled-in file. It grants database, email, object storage
# and administrative access.

# ----- identity of this release -------------------------------------------
APP_ENV=production
# Must identify the deployed build. Use the git SHA you deployed.
APP_VERSION=replace-with-the-deployed-commit-sha

# The public hostname, without scheme. Must resolve to this server and have a
# valid DNS record before the first start, because certificates are issued over
# ACME against it.
PUBLIC_HOSTNAME=example.com
# Address the certificate authority uses for expiry notices.
ACME_EMAIL=you@example.com

# Which product vertical this deployment serves. One active recommendation
# policy exists per vertical, and the catalog is scoped the same way.
RECOMMENDATION_VERTICAL=saas

# ----- database ------------------------------------------------------------
POSTGRES_DB=unsolero
POSTGRES_USER=unsolero
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Keep the connection budget below the server's max_connections.
POSTGRES_MAX_CONNECTIONS=60
POSTGRES_SHARED_BUFFERS=256MB
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2

# ----- rate-limit store ----------------------------------------------------
# URL-safe: this value is embedded in a rediss:// URL, so avoid @ / : and #.
VALKEY_PASSWORD=replace-with-a-long-url-safe-password
VALKEY_MAXMEMORY=192mb

# ----- secrets -------------------------------------------------------------
# Each must be raw base64 for exactly 32 bytes. Rotating MFA_ENCRYPTION_KEY
# invalidates every enrolled authenticator, so store it somewhere durable.
MFA_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-no-padding
RATE_LIMIT_KEY_SECRET=replace-with-openssl-rand-base64-32-no-padding
# Bearer token for the operational metrics endpoint.
METRICS_TOKEN=replace-with-openssl-rand-base64-32-no-padding

# ----- object storage ------------------------------------------------------
# Cloudflare R2 is S3-compatible and bills no egress. The endpoint is a host
# and optional port with no scheme.
# Find it under R2 > Manage R2 API Tokens; it looks like:
#   <accountid>.r2.cloudflarestorage.com
MEDIA_S3_ENDPOINT=replace-with-your-account.r2.cloudflarestorage.com
MEDIA_S3_ACCESS_KEY=replace-with-the-r2-access-key-id
MEDIA_S3_SECRET_KEY=replace-with-the-r2-secret-access-key
MEDIA_S3_BUCKET=unsolero-media
# R2 ignores the region but the S3 client requires one.
MEDIA_S3_REGION=auto

# ----- malware scanning ----------------------------------------------------
# Points at the clamav container. The API verifies the daemon answers during
# startup and refuses to boot if it does not.
MEDIA_SCAN_ENDPOINT=clamav:3310
MEDIA_SCAN_TIMEOUT=20s

# ----- transactional email -------------------------------------------------
# Account security messages only; this is not a marketing sender. A free tier
# from Resend or Brevo is sufficient at launch. The sender address must be on a
# domain you have verified with the provider or delivery will be rejected.
EMAIL_SENDER_NAME=UNSOLERO
EMAIL_SENDER_ADDRESS=security@example.com
EMAIL_SMTP_ADDRESS=smtp.example.com:587
EMAIL_SMTP_USERNAME=replace-with-the-smtp-username
EMAIL_SMTP_PASSWORD=replace-with-the-smtp-password

# ----- operational alerting ------------------------------------------------
# Must be HTTPS, must not be a loopback address, and must carry no query string
# or credentials in the URL. A Discord or Slack incoming webhook works and
# costs nothing.
ALERT_WEBHOOK_URL=https://replace-with-your-webhook-endpoint
# Required, and at least 32 characters. Sent as a bearer token so the receiving
# endpoint can reject anything that is not this deployment. Discord and Slack
# ignore the header, but the value is still mandatory; generate one with
#   openssl rand -base64 32 | tr -d '='
ALERT_WEBHOOK_TOKEN=replace-with-at-least-32-characters

# ----- session -------------------------------------------------------------
# Changing this signs out every existing session.
SESSION_COOKIE_NAME=rigmark_session

# ----- proxy ---------------------------------------------------------------
# The CIDR the reverse proxy connects from. Docker's default bridge pool is
# 172.16.0.0/12. Widening this lets a client spoof its own IP to the rate
# limiter, so keep it as narrow as your network allows.
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# A single box runs one API replica. Raising this without a shared rate-limit
# store is rejected at startup.
API_REPLICA_COUNT=1

# ----- backups -------------------------------------------------------------
# Where scripts/backup-to-r2.sh uploads dumps. Use a bucket in a different
# location from the media bucket so one deletion does not take both.
BACKUP_S3_BUCKET=unsolero-backups
BACKUP_RETENTION_DAYS=30
