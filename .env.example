# Local development only. Replace every value outside local development.
POSTGRES_DB=rigmark
POSTGRES_USER=rigmark
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgres://rigmark:change-me-for-local-development@localhost:5432/rigmark?sslmode=disable
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
DATABASE_MAX_CONNECTION_LIFETIME=30m
DATABASE_MAX_CONNECTION_IDLE_TIME=5m
DATABASE_HEALTH_CHECK_PERIOD=1m
DATABASE_CONNECT_TIMEOUT=10s
DATABASE_STATEMENT_TIMEOUT=15s
DATABASE_LOCK_TIMEOUT=5s
DATABASE_IDLE_TRANSACTION_TIMEOUT=30s
DATABASE_MIGRATION_TIMEOUT=5m
APP_ENV=development
APP_VERSION=development
# Only the isolated loopback Compose staging overlay may set this true.
ALLOW_INSECURE_LOCAL_STAGING=false
PUBLIC_SITE_URL=http://localhost:5173

# Selects which vertical this deployment serves. The database holds one active
# recommendation policy per vertical, so this repoints the product at a
# different catalog and policy without a code change. Startup fails if no
# active policy exists for the value.
RECOMMENDATION_VERTICAL=saas
API_PORT=8080
WEB_PORT=5173
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_HANDLER_TIMEOUT=20s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_HEADER_BYTES=32768
# Comma-separated edge proxy CIDRs. Empty means forwarding headers are ignored.
# Never trust a whole private network in production; use only the exact proxy range.
TRUSTED_PROXY_CIDRS=
SESSION_COOKIE_NAME=rigmark_session
SESSION_COOKIE_SECURE=false
SESSION_TTL=720h
SESSION_IDLE_TTL=168h
# Local intent sink only; production must use a reviewed external adapter.
EMAIL_PROVIDER=development
EMAIL_SENDER_NAME="UNSOLERO Security"
EMAIL_SENDER_ADDRESS=
EMAIL_SMTP_ADDRESS=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_REQUIRE_TLS=false
EMAIL_SMTP_TIMEOUT=10s
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=1h
MFA_CHALLENGE_TTL=5m
MFA_STEP_UP_TTL=15m
MFA_ENFORCE_PRIVILEGED=false
# Raw-standard base64 for exactly 32 random bytes. Empty uses an ephemeral key
# in development only; set a stable secret to keep local MFA across restarts.
MFA_ENCRYPTION_KEY=
API_REPLICA_COUNT=1
RATE_LIMIT_PROVIDER=local
# Used only when RATE_LIMIT_PROVIDER=redis. Production requires rediss://.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_NAMESPACE=unsolero:rate-limit
# Raw-standard base64 for 32 random bytes. Required and stable in production.
RATE_LIMIT_KEY_SECRET=
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_REGISTRATION_PER_MINUTE=5
RATE_LIMIT_PASSWORD_RESET_PER_MINUTE=5
RATE_LIMIT_RECOMMENDATION_PER_MINUTE=20
RATE_LIMIT_ANALYTICS_PER_MINUTE=120
RATE_LIMIT_AFFILIATE_PER_MINUTE=120
RATE_LIMIT_ADMIN_PER_MINUTE=240
RATE_LIMIT_MUTATION_PER_MINUTE=240
RATE_LIMIT_ROUTE_PER_MINUTE=600
# Offers older than this are hidden and cannot redirect until refreshed.
OFFER_MAXIMUM_AGE=72h
AFFILIATE_CLICK_RETENTION=9528h
COMMERCE_WORKER_POLL_INTERVAL=15s
WORKER_CYCLE_TIMEOUT=2m
WORKER_LEASE_TIMEOUT=1h
WORKER_MAX_ITEMS_PER_CYCLE=25
WORKER_FAILURE_ALERT_THRESHOLD=3
# Privacy engineering defaults. Legal/privacy review must approve production values.
ANALYTICS_SUBJECT_COOKIE_NAME=unsolero_analytics_subject
ANALYTICS_ANONYMOUS_RETENTION=2160h
ANALYTICS_AUTHENTICATED_RETENTION=9528h
ANALYTICS_RECEIPT_RETENTION=720h
ANALYTICS_CLEANUP_BATCH_SIZE=1000
# "webhook" is the built-in authenticated HTTPS adapter. "external" remains a
# fail-closed extension point. Hosted staging/production reject "disabled".
ALERT_PROVIDER=disabled
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
ALERT_TIMEOUT=10s
# Privacy-safe aggregate endpoint. Hosted staging/production require this with
# a secret bearer token of at least 32 characters.
METRICS_ENABLED=false
METRICS_TOKEN=
MIGRATIONS_DIR=./migrations
SEEDS_DIR=./seeds
PRODUCT_IMAGE_UPLOAD_DIR=./uploads/products
# Local is single-replica development only. Production requires a reviewed
# S3-compatible/object-storage adapter and fails startup until it is linked.
MEDIA_STORAGE_PROVIDER=local
# S3-compatible storage. Endpoint is host:port without a URL scheme. These
# local blanks must be injected from a secret manager outside development.
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_SECURE=false
# Development performs format/signature validation but is not malware scanning.
# Production requires a reviewed external scanner and fails startup without it.
MEDIA_SCAN_PROVIDER=development
# Server-only optional AI integration. No VITE_ variable may contain these values.
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT=15s
AI_MAX_RESPONSE_BYTES=65536
VITE_DEV_API_PROXY_TARGET=http://localhost:8080
# Local backup/restore tool profile only.
BACKUP_NAME=unsolero-local
RECORD_OPERATIONAL_CHECKPOINTS=false
BACKUP_UID=1000
BACKUP_GID=1000
RESTORE_POSTGRES_DB=rigmark_restore
# Opt-in `staging` Compose profile. These are isolated local test credentials,
# never production defaults.
STAGING_REDIS_PASSWORD=replace-for-isolated-staging
STAGING_REDIS_PORT=6380
STAGING_MINIO_ROOT_USER=unsolero-staging
STAGING_MINIO_ROOT_PASSWORD=replace-for-isolated-staging-storage
STAGING_MINIO_PORT=9000
STAGING_MINIO_CONSOLE_PORT=9001
STAGING_TLS_PORT=8443
