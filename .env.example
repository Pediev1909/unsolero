# Local development only. Replace every value outside local development.
POSTGRES_DB=rigmark
POSTGRES_USER=rigmark
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgres://rigmark:change-me-for-local-development@localhost:5432/rigmark?sslmode=disable
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
DATABASE_MAX_CONNECTION_LIFETIME=30m
DATABASE_MAX_CONNECTION_IDLE_TIME=5m
DATABASE_HEALTH_CHECK_PERIOD=1m
DATABASE_CONNECT_TIMEOUT=10s
APP_ENV=development
APP_VERSION=development
PUBLIC_SITE_URL=http://localhost:5173
API_PORT=8080
WEB_PORT=5173
SESSION_COOKIE_NAME=rigmark_session
SESSION_COOKIE_SECURE=false
SESSION_TTL=720h
SESSION_IDLE_TTL=168h
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_RECOMMENDATION_PER_MINUTE=20
RATE_LIMIT_ANALYTICS_PER_MINUTE=120
RATE_LIMIT_AFFILIATE_PER_MINUTE=120
RATE_LIMIT_MUTATION_PER_MINUTE=240
# Offers older than this are hidden and cannot redirect until refreshed.
OFFER_MAXIMUM_AGE=72h
MIGRATIONS_DIR=./migrations
SEEDS_DIR=./seeds
PRODUCT_IMAGE_UPLOAD_DIR=./uploads/products
# Server-only optional AI integration. No VITE_ variable may contain these values.
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT=15s
AI_MAX_RESPONSE_BYTES=65536
VITE_DEV_API_PROXY_TARGET=http://localhost:8080
